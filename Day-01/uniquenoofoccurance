class Solution(object):
    def uniqueOccurrences(self, arr):
        count = {}

        # Find frequency of each element
        for i in arr:
            if i in count:
                count[i] += 1
            else:
                count[i] = 1

        # Compare frequencies
        for i in count:
            for j in count:
                if i != j and count[i] == count[j]:
                    return False

        return True