class Solution(object):
    def findIntersectionValues(self, nums1, nums2):

        res = []
        res2 = []

        for i in range(len(nums1)):
            if nums1[i] in nums2:
                res.append(i)

        for i in range(len(nums2)):
            if nums2[i] in nums1:
                res2.append(i)

        return [len(res), len(res2)]